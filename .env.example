DJANGO_SETTINGS_MODULE=arvion.settings.production
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
TRUSTED_PROXY_IPS=127.0.0.1,::1
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
SECURE_SSL_REDIRECT=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_HSTS_SECONDS=31536000
DATABASE_URL=postgresql://user:password@host:5432/arvion

PAYMENT_GATEWAY=card_transfer
CARD_PAYMENT_NUMBER=6219861821208849
CARD_PAYMENT_HOLDER='آروین یزدانی'

EMAIL_HOST=smtp.postmarkapp.com
USE_SMTP_EMAIL=1
MANUAL_ACCOUNT_APPROVAL=0
CONTRACT_ACCESS_PASSWORD=replace-with-a-long-unique-contract-room-password
CONTRACT_ACCESS_ATTEMPTS=5
CONTRACT_ACCESS_WINDOW_SECONDS=900
CACHE_URL=
CACHE_FILE_LOCATION=/var/tmp/rvion-django-cache
CACHE_KEY_PREFIX=rvion-production
CACHE_DEFAULT_TIMEOUT=3600
CACHE_MAX_ENTRIES=10000
WEB_PUSH_ALLOWED_HOST_SUFFIXES=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL='Arvion <noreply@example.com>'
CONTACT_NOTIFICATION_EMAIL=owner@example.com

# SMS: keep MELIPAYAMAK_PASSWORD (the API key) only in the server environment.
SMS_BACKEND=core.sms.backends.MelipayamakSMSBackend
MELIPAYAMAK_USERNAME=9333021100
MELIPAYAMAK_PASSWORD=replace-with-api-key
MELIPAYAMAK_SENDER_NUMBER=50004001021100
# OTP delivery uses the approved BaseServiceNumber pattern; request this ID
# from Melipayamak and keep the real value only in the server environment.
MELIPAYAMAK_OTP_MODE=pattern
MELIPAYAMAK_BODY_ID=replace-with-approved-otp-body-id
SMS_HTTP_TIMEOUT=10
MANAGEMENT_ALERT_SMS_RECIPIENTS=989120373271
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@rvionai.com
MANAGEMENT_REMINDER_SECONDS=3600
PAYMENT_AUTO_APPROVE_SECONDS=180
# Application error logs are retained for 90 days by default.
SYSTEM_LOG_RETENTION_DAYS=90
# Card-transfer access is auto-approved after 3 minutes unless staff acts first.
# Operational SLA: payment 30 minutes, first support response 4 working hours,
# and initial discovery/contract follow-up 1 working day.
PAYMENT_REVIEW_SLA_SECONDS=1800
SUPPORT_FIRST_RESPONSE_SLA_SECONDS=14400
SALES_FOLLOW_UP_SLA_SECONDS=86400
OTP_TTL_SECONDS=300
OTP_REQUEST_LIMIT=3
OTP_REQUEST_WINDOW_SECONDS=600
OTP_MAX_VERIFY_ATTEMPTS=5

ASSESSMENT_SUPPORT_TICKETS_PER_HOUR=5
ASSESSMENT_ATTEMPTS_PER_DAY=5
AUTH_LOGIN_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_EMAIL_REQUESTS=4
AUTH_EMAIL_WINDOW_SECONDS=3600

# S3-compatible media storage (AWS S3, Cloudflare R2, Liara Object Storage, ...)
USE_S3_STORAGE=1
AWS_STORAGE_BUCKET_NAME=arvion-media
AWS_S3_ENDPOINT_URL=https://your-s3-endpoint.example
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=media.example.com
