# Production only. Local development works without these values.
DJANGO_SETTINGS_MODULE=arvion.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=rvin-tech.com,www.rvin-tech.com
DATABASE_URL=postgresql://user:password@host:5432/arvion
CSRF_TRUSTED_ORIGINS=https://rvin-tech.com,https://www.rvin-tech.com
DEFAULT_FROM_EMAIL=Arvion <noreply@rvin-tech.com>
CONTACT_NOTIFICATION_EMAIL=hello@rvin-tech.com
EMAIL_HOST=smtp.postmarkapp.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
